{
  // Ctrl+Shift+P → "Tasks: Run Task" to pick one.
  // Ctrl+Shift+B runs the default build task (Typecheck).
  "version": "2.0.0",
  "tasks": [
    {
      // Catches type errors without running the agent — no tokens spent.
      // Worth doing before a debug run when you've changed tool schemas.
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // Watch mode: type errors appear in the Problems panel as you type.
      "label": "Typecheck (watch)",
      "type": "shell",
      "command": "npx tsc --noEmit --watch --preserveWatchOutput",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "presentation": { "reveal": "never", "panel": "dedicated" }
    },
    {
      "label": "Auth check",
      "type": "npm",
      "script": "check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      // Prints every exported symbol in the installed SDK. This is the
      // authoritative answer to "does this function exist?" — it beats docs
      // and it beats my memory. Get in the habit of reaching for it.
      "label": "List SDK exports",
      "type": "shell",
      "command": "grep -n 'export declare' node_modules/@anthropic-ai/claude-agent-sdk/sdk.d.ts | less",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
